function CameraPreview({
  videoRef,
  isCameraReady,
  errorMessage,
  cameraError,
  error,
  className = '',
}) {
  const message = errorMessage || cameraError || error || ''
  const hasVideoStream = Boolean(videoRef?.current?.srcObject)
  const shouldShowError = Boolean(message) && !isCameraReady && !hasVideoStream

  return (
    <div className="relative h-full min-h-[360px] overflow-hidden rounded-[1.8rem] border border-white/10 bg-slate-900 shadow-2xl shadow-black/30">
      <video
        ref={videoRef}
        autoPlay
        playsInline
        muted
        className="h-full w-full object-cover"
      />

      {!isCameraReady && !message && (
        <div className="absolute inset-0 flex items-center justify-center bg-slate-950/35 px-6 text-center backdrop-blur-sm">
          <p className="text-sm font-semibold text-slate-200">
            Menyiapkan kamera...
          </p>
        </div>
      )}

      {shouldShowError && (
        <div className="absolute inset-0 flex items-center justify-center bg-slate-950/55 px-6 text-center backdrop-blur-sm">
          <div className="max-w-md rounded-2xl border border-red-300/20 bg-red-500/10 p-4">
            <p className="text-sm font-semibold leading-6 text-red-200">
              {message}
            </p>
            <p className="mt-2 text-xs leading-5 text-red-100/80">
              Tutup tab photobooth lain atau izinkan akses kamera di browser.
            </p>
          </div>
        </div>
      )}
    </div>
  )
}

export default CameraPreview
