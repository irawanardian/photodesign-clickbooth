const API_ORIGIN =
  import.meta.env.VITE_API_ORIGIN ||
  `${window.location.protocol}//${window.location.hostname}:5005`

function resolveAssetUrl(url) {
  if (!url) return ''
  if (url.startsWith('data:')) return url
  if (url.startsWith('http://') || url.startsWith('https://')) return url

  return `${API_ORIGIN}${url}`
}

function loadImage(src) {
  return new Promise((resolve, reject) => {
    if (!src) {
      resolve(null)
      return
    }

    const image = new Image()
    image.crossOrigin = 'anonymous'

    image.onload = () => resolve(image)
    image.onerror = () => reject(new Error('Gagal memuat file template.'))

    image.src = src
  })
}

function drawImageCover(context, image, x, y, width, height) {
  const imageWidth = image?.videoWidth || image?.naturalWidth || image?.width
  const imageHeight = image?.videoHeight || image?.naturalHeight || image?.height

  if (!imageWidth || !imageHeight) return

  const imageRatio = imageWidth / imageHeight
  const targetRatio = width / height

  let sourceX = 0
  let sourceY = 0
  let sourceWidth = imageWidth
  let sourceHeight = imageHeight

  if (imageRatio > targetRatio) {
    sourceWidth = imageHeight * targetRatio
    sourceX = (imageWidth - sourceWidth) / 2
  } else {
    sourceHeight = imageWidth / targetRatio
    sourceY = (imageHeight - sourceHeight) / 2
  }

  context.drawImage(
    image,
    sourceX,
    sourceY,
    sourceWidth,
    sourceHeight,
    x,
    y,
    width,
    height,
  )
}

function getVideoObjectCoverRect(videoElement) {
  const videoRect = videoElement.getBoundingClientRect()
  const videoWidth = videoElement.videoWidth
  const videoHeight = videoElement.videoHeight

  const elementRatio = videoRect.width / videoRect.height
  const videoRatio = videoWidth / videoHeight

  let renderedWidth = videoRect.width
  let renderedHeight = videoRect.height
  let offsetX = 0
  let offsetY = 0

  if (videoRatio > elementRatio) {
    renderedHeight = videoRect.height
    renderedWidth = renderedHeight * videoRatio
    offsetX = (videoRect.width - renderedWidth) / 2
  } else {
    renderedWidth = videoRect.width
    renderedHeight = renderedWidth / videoRatio
    offsetY = (videoRect.height - renderedHeight) / 2
  }

  return {
    videoRect,
    videoWidth,
    videoHeight,
    renderedWidth,
    renderedHeight,
    offsetX,
    offsetY,
  }
}

export function captureVideoFrame(videoElement, guideElement = null, options = {}) {
  if (!videoElement) return ''

  const guideRect = guideElement?.getBoundingClientRect?.()
  const requestedAspectRatio = Number(options.aspectRatio)
  const guideAspectRatio = guideRect?.width && guideRect?.height
    ? guideRect.width / guideRect.height
    : 0

  const aspectRatio = Number.isFinite(requestedAspectRatio) && requestedAspectRatio > 0
    ? requestedAspectRatio
    : guideAspectRatio > 0
      ? guideAspectRatio
      : 4 / 3

  const canvas = document.createElement('canvas')
  const context = canvas.getContext('2d')

  canvas.width = 1200
  canvas.height = Math.round(canvas.width / aspectRatio)

  if (!guideElement || !guideRect?.width || !guideRect?.height) {
    context.save()
    context.translate(canvas.width, 0)
    context.scale(-1, 1)
    drawImageCover(context, videoElement, 0, 0, canvas.width, canvas.height)
    context.restore()

    return canvas.toDataURL('image/jpeg', 0.95)
  }

  const {
    videoRect,
    videoWidth,
    videoHeight,
    renderedWidth,
    renderedHeight,
    offsetX,
    offsetY,
  } = getVideoObjectCoverRect(videoElement)

  const guideLeftInVideoBox = guideRect.left - videoRect.left
  const guideTopInVideoBox = guideRect.top - videoRect.top

  const sourceX = ((guideLeftInVideoBox - offsetX) / renderedWidth) * videoWidth
  const sourceY = ((guideTopInVideoBox - offsetY) / renderedHeight) * videoHeight
  const sourceWidth = (guideRect.width / renderedWidth) * videoWidth
  const sourceHeight = (guideRect.height / renderedHeight) * videoHeight

  context.save()
  context.translate(canvas.width, 0)
  context.scale(-1, 1)
  context.drawImage(
    videoElement,
    sourceX,
    sourceY,
    sourceWidth,
    sourceHeight,
    0,
    0,
    canvas.width,
    canvas.height,
  )
  context.restore()

  return canvas.toDataURL('image/jpeg', 0.95)
}

function drawPhotoSlot(context, image, x, y, width, height) {
  context.save()
  context.fillStyle = '#ffffff'
  context.fillRect(x, y, width, height)

  if (image) {
    drawImageCover(context, image, x, y, width, height)
  }

  context.restore()
}

function drawPanelBackground(context, frame, x, y, width, height) {
  context.fillStyle = frame.backgroundColor || '#ffffff'
  context.fillRect(x, y, width, height)
}

function drawPanelText(context, frame, x, y, width, totalPhotos, countdownSeconds, layoutName) {
  context.save()
  context.textAlign = 'center'

  context.fillStyle = frame.accentColor || '#ec4899'
  context.fillRect(x + width * 0.18, y + 28, width * 0.64, 10)

  context.fillStyle = frame.textColor || '#111827'
  context.font = '900 28px Arial'
  context.fillText(frame.title || 'PHOTOBOOTH', x + width / 2, y + 78)

  context.fillStyle = frame.mutedTextColor || '#64748b'
  context.font = '700 14px Arial'
  context.fillText(frame.subtitle || 'Web Photo Session', x + width / 2, y + 104)

  context.fillStyle = frame.textColor || '#111827'
  context.font = '800 13px Arial'
  context.fillText(
    `${layoutName || 'Strip'} • ${totalPhotos} Foto • ${countdownSeconds}s`,
    x + width / 2,
    y + height - 26,
  )

  context.restore()
}

function getPhotoSlots(layout, totalPhotos, x, y, width, height, hasOverlay) {
  const isGrid = layout?.id === 'grid-2x2'

  const topPadding = hasOverlay ? 48 : 140
  const bottomPadding = hasOverlay ? 48 : 70
  const sidePadding = hasOverlay ? 36 : 36
  const gap = hasOverlay ? 14 : 16

  const contentX = x + sidePadding
  const contentY = y + topPadding
  const contentWidth = width - sidePadding * 2
  const contentHeight = height - topPadding - bottomPadding

  if (isGrid) {
    const columns = 2
    const rows = Math.ceil(totalPhotos / 2)
    const slotWidth = (contentWidth - gap) / columns
    const slotHeight = (contentHeight - gap * (rows - 1)) / rows

    return Array.from({ length: totalPhotos }).map((_, index) => {
      const column = index % 2
      const row = Math.floor(index / 2)

      return {
        x: contentX + column * (slotWidth + gap),
        y: contentY + row * (slotHeight + gap),
        width: slotWidth,
        height: slotHeight,
      }
    })
  }

  const slotHeight = (contentHeight - gap * (totalPhotos - 1)) / totalPhotos
  const targetRatio = 4 / 3

  return Array.from({ length: totalPhotos }).map((_, index) => {
    const rawY = contentY + index * (slotHeight + gap)
    let slotWidth = contentWidth
    let adjustedHeight = slotHeight

    if (slotWidth / adjustedHeight > targetRatio) {
      slotWidth = adjustedHeight * targetRatio
    } else {
      adjustedHeight = slotWidth / targetRatio
    }

    return {
      x: contentX + (contentWidth - slotWidth) / 2,
      y: rawY + (slotHeight - adjustedHeight) / 2,
      width: slotWidth,
      height: adjustedHeight,
    }
  })
}

function drawPanel(context, images, frame, layout, options) {
  const {
    x,
    y,
    width,
    height,
    totalPhotos,
    countdownSeconds,
    hasOverlay,
  } = options

  drawPanelBackground(context, frame, x, y, width, height)

  if (!hasOverlay) {
    drawPanelText(
      context,
      frame,
      x,
      y,
      width,
      totalPhotos,
      countdownSeconds,
      layout?.name,
    )
  }

  const slots = getPhotoSlots(layout, totalPhotos, x, y, width, height, hasOverlay)

  slots.forEach((slot, index) => {
    drawPhotoSlot(context, images[index], slot.x, slot.y, slot.width, slot.height)
  })
}

function getPrintSizeId(printSize) {
  if (!printSize) return '4r'
  if (typeof printSize === 'string') return printSize.toLowerCase()

  return String(printSize.id || '4r').toLowerCase()
}

function hasCustomSlots(frame) {
  return Array.isArray(frame?.photoSlots) && frame.photoSlots.length > 0
}

function drawCustomSlots(context, images, frame, canvasWidth, canvasHeight) {
  frame.photoSlots.forEach((slot, index) => {
    const x = (Number(slot.x) / 100) * canvasWidth
    const y = (Number(slot.y) / 100) * canvasHeight
    const width = (Number(slot.width) / 100) * canvasWidth
    const height = (Number(slot.height) / 100) * canvasHeight

    if (width <= 0 || height <= 0) return

    const photoIndex = Number.isInteger(Number(slot.photoIndex))
      ? Number(slot.photoIndex)
      : index

    const image = images[photoIndex % images.length] || images[index % images.length]

    drawPhotoSlot(context, image, x, y, width, height)
  })
}

async function drawFrameImageLayers(context, frame, canvasWidth, canvasHeight) {
  const layers = Array.isArray(frame?.imageLayers) ? frame.imageLayers : []

  if (!layers.length) return

  const sortedLayers = [...layers].sort((a, b) => {
    const zA = Number.isFinite(Number(a?.zIndex)) ? Number(a.zIndex) : 0
    const zB = Number.isFinite(Number(b?.zIndex)) ? Number(b.zIndex) : 0

    return zA - zB
  })

  for (const layer of sortedLayers) {
    const layerUrl = resolveAssetUrl(layer?.imageUrl || layer?.imageDataUrl)

    if (!layerUrl) continue

    try {
      const image = await loadImage(layerUrl)
      const x = (Number(layer.x || 0) / 100) * canvasWidth
      const y = (Number(layer.y || 0) / 100) * canvasHeight
      const width = Math.max(1, (Number(layer.width || 100) / 100) * canvasWidth)
      const height = Math.max(1, (Number(layer.height || 100) / 100) * canvasHeight)

      context.drawImage(image, x, y, width, height)
    } catch (error) {
      console.warn('Gagal memuat image layer template:', layer?.name || layer?.id || layerUrl)
    }
  }
}

export async function createPhotoboothStrip(photos, frame, layout, printSize = '4r') {
  const printSizeId = getPrintSizeId(printSize)
  const is4R = printSizeId === '4r'
  const canvas = document.createElement('canvas')
  const context = canvas.getContext('2d')

  const frameCanvasWidth = Number(frame?.canvasWidth)
  const frameCanvasHeight = Number(frame?.canvasHeight)

  canvas.width = Number.isFinite(frameCanvasWidth) && frameCanvasWidth > 0
    ? frameCanvasWidth
    : is4R ? 1200 : 600

  canvas.height = Number.isFinite(frameCanvasHeight) && frameCanvasHeight > 0
    ? frameCanvasHeight
    : 1800

  const hasOverlay = Boolean(frame?.overlayImageUrl)
  const overlayUrl = resolveAssetUrl(frame?.overlayImageUrl)

  const images = await Promise.all(
    photos.map((photo) => loadImage(photo)),
  )

  const overlayImage = overlayUrl ? await loadImage(overlayUrl) : null

  context.fillStyle = frame?.backgroundColor || '#ffffff'
  context.fillRect(0, 0, canvas.width, canvas.height)

  if (hasCustomSlots(frame)) {
    drawCustomSlots(context, images, frame, canvas.width, canvas.height)
  } else if (is4R) {
    const panelWidth = canvas.width / 2

    drawPanel(context, images, frame, layout, {
      x: 0,
      y: 0,
      width: panelWidth,
      height: canvas.height,
      totalPhotos: photos.length,
      countdownSeconds: frame?.countdownSeconds || 3,
      hasOverlay,
    })

    drawPanel(context, images, frame, layout, {
      x: panelWidth,
      y: 0,
      width: panelWidth,
      height: canvas.height,
      totalPhotos: photos.length,
      countdownSeconds: frame?.countdownSeconds || 3,
      hasOverlay,
    })

    context.fillStyle = frame?.accentColor || '#ec4899'
    context.fillRect(panelWidth - 0.5, 0, 1, canvas.height)
  } else {
    drawPanel(context, images, frame, layout, {
      x: 0,
      y: 0,
      width: canvas.width,
      height: canvas.height,
      totalPhotos: photos.length,
      countdownSeconds: frame?.countdownSeconds || 3,
      hasOverlay,
    })
  }

  if (overlayImage) {
    context.drawImage(overlayImage, 0, 0, canvas.width, canvas.height)
  }

  await drawFrameImageLayers(context, frame, canvas.width, canvas.height)

  return canvas.toDataURL('image/png')
}
